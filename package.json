{
  "name": "react-native-media-styles-workspace",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "pnpm --filter @react-native-media-styles/core test",
    "typecheck": "pnpm --filter @react-native-media-styles/core typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "demo:ssr": "pnpm --dir examples/expo start:ssr",
    "demo:spa": "pnpm --dir examples/expo start:spa",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "packageManager": "pnpm@12.9.1"
}
